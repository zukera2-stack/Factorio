# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp

# Local test artifacts
*.orig

# All generated build output (install ZIPs, preview atlases, temporary staging)
/build/

# Keep high-resolution art sources and duplicate test archives out of active Git tree.
# Archived pre-cleanup versions remain retrievable from Git history.
art/sources/
art/archives/

# dist is historical only; preserve the explicitly tracked 0.1.8 rollback archive.
/dist/*
!/dist/ElectrifiedMainline_0.1.8.zip
__pycache__/
*.py[cod]

# 049 game sprites are generated from tracked source by CI, never manual QA art.
/ElectrifiedMainline/graphics/entity/locomotive-049/

# Full 052 locomotive sheets produced by GitHub Actions, not distributed from Library.
/ElectrifiedMainline/graphics/entity/locomotive-052/
